# AXIOM V4 Unified Configuration

# Server & UI
HOST=0.0.0.0
PORT=8000
UI_BASE_URL=http://localhost:8000

# NVIDIA NIM / LLM CONFIGURATION
LLM_PROVIDER=nvidia_nim
# Never commit real credentials. Put them only in your local .env or secret manager.
MOONSHOT_API_KEY=your_nvidia_nim_key_here
NEMOTRON_API_KEY=your_nvidia_nim_key_here
MINIMAX_API_KEY=your_nvidia_nim_key_here
MISTRAL_API_KEY=your_nvidia_nim_key_here

# Optional generic OpenAI-compatible provider.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# LOCAL LLM FALLBACK MODELS
LOCAL_REASONING_MODEL_PATH=NVIDIA-Nemotron-3-Nano-4B-Q4_K_M.gguf
LOCAL_GENERAL_MODEL_PATH=Qwen2.5-3B-Instruct-Q4_K_M.gguf
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# RISK CONTROLS
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=5
MIN_SIGNAL_CONFIDENCE=0.70
MIN_CONSENSUS_AGENTS=3
FORCE_CLOSE_LOSS_PCT=0.20
MAX_LEVERAGE=10
BALANCE_RESERVE_PCT=0.20
MANDATORY_STOP_LOSS_PCT=0.05

# EXECUTION SAFETY
# Safe defaults: paper trading ON and autonomous execution OFF.
PAPER_TRADE_MODE=true
AUTOTRADE_ENABLED=false
REQUIRE_PROTECTIVE_ORDERS=true
REQUIRE_STRATEGY_VALIDATION=true
ALLOW_POSITION_ADDONS=false
TRADING_CYCLE_MINUTES=5
LIVE_STRATEGY_ID=hyperliquid-agent-v1

# To permit real-money execution you must intentionally set ALL of the following:
# PAPER_TRADE_MODE=false
# AUTOTRADE_ENABLED=true
# LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_TRADING
# HYPERLIQUID_PRIVATE_KEY=<private key from your secret manager>
LIVE_TRADING_ACK=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_ASSETS=["BTC","ETH","SOL"]
HYPERLIQUID_INTERVAL=5m
HYPERLIQUID_MAX_SLIPPAGE_PCT=0.01

# DEPLOYMENT VALIDATION GATES
STRATEGY_VALIDATION_MAX_AGE_DAYS=30
MIN_BACKTEST_SHARPE=1.0
MAX_BACKTEST_DRAWDOWN_PCT=20.0
MIN_BACKTEST_WIN_RATE=0.52
MIN_BACKTEST_TRADES=30
MIN_BACKTEST_PROFIT_FACTOR=1.20

# PAPER EXECUTION ASSUMPTIONS
PAPER_STARTING_BALANCE=100000
PAPER_SLIPPAGE_BPS=5
PAPER_FEE_BPS=4

# SCHEDULER
NEWS_FETCH_INTERVAL_MIN=10
PRICE_FETCH_INTERVAL_MIN=5
RAG_REINDEX_INTERVAL_MIN=15

# Mission Control Automation
GITHUB_PAT=
GITHUB_REPO=logeshv586-code/AITradra
