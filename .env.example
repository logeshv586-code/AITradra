# AXIOM V4 Unified Configuration

# Server & UI
HOST=0.0.0.0
PORT=8000
UI_BASE_URL=http://localhost:8000

# NVIDIA NIM / LLM CONFIGURATION
LLM_PROVIDER=nvidia_nim
# Never commit real credentials. Put them only in your local .env or secret manager.
MOONSHOT_API_KEY=your_nvidia_nim_key_here
NEMOTRON_API_KEY=your_nvidia_nim_key_here
MINIMAX_API_KEY=your_nvidia_nim_key_here
MISTRAL_API_KEY=your_nvidia_nim_key_here

# Optional generic OpenAI-compatible provider.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# LOCAL LLM FALLBACK MODELS
LOCAL_REASONING_MODEL_PATH=NVIDIA-Nemotron-3-Nano-4B-Q4_K_M.gguf
LOCAL_GENERAL_MODEL_PATH=Qwen2.5-3B-Instruct-Q4_K_M.gguf
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# RISK CONTROLS
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=5
MIN_SIGNAL_CONFIDENCE=0.70
MIN_CONSENSUS_AGENTS=3
FORCE_CLOSE_LOSS_PCT=0.20
MAX_LEVERAGE=10
BALANCE_RESERVE_PCT=0.20
MANDATORY_STOP_LOSS_PCT=0.05

# EXECUTION SAFETY
# Safe defaults: practice trading ON; both manual and autonomous real-money execution OFF.
PAPER_TRADE_MODE=true
AUTOTRADE_ENABLED=false
MANUAL_LIVE_TRADING_ENABLED=false
REQUIRE_PROTECTIVE_ORDERS=true
REQUIRE_STRATEGY_VALIDATION=true
REQUIRE_EMPIRICAL_PRECISION_VALIDATION=true
ALLOW_POSITION_ADDONS=false
TRADING_CYCLE_MINUTES=5
LIVE_STRATEGY_ID=hyperliquid-agent-v1

# STRICT DECISION-GRADE LIVE PRICE
# This path is used for qualification-sensitive agents. It does not substitute
# historical/cache data when the selected real-time provider is unavailable.
# The first enabled market-data connection is authoritative. When cross-check is
# required, the second enabled live connection validates the price but is NEVER
# used as a fallback execution price.
LIVE_PRICE_VALIDITY_SECONDS=120
LIVE_PRICE_REQUIRE_CROSSCHECK=true
LIVE_PRICE_MAX_CROSSCHECK_DIFF_PCT=1.0

# EMPIRICAL AUTONOMOUS-LIVE PRECISION GATE
# These are eligibility thresholds, not promises of future accuracy or profit.
AUTOTRADE_TARGET_PRECISION=0.99
AUTOTRADE_MIN_SIGNAL_CONFIDENCE=90.0
AUTOTRADE_MIN_EVALUATED_SIGNALS=100
AUTOTRADE_MIN_PRECISION_LOWER_BOUND=0.95
PRECISION_LOOKBACK_DAYS=90
PRECISION_VALIDATION_MAX_AGE_DAYS=30

# Manual real-money trading from the customer Trading page requires:
# PAPER_TRADE_MODE=false
# MANUAL_LIVE_TRADING_ENABLED=true
# LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_TRADING
# plus a Hyperliquid private key stored through the encrypted in-app connection screen.
# AUTOTRADE_ENABLED can stay false for manual-only real trading.
#
# Autonomous trading is a separate permission and additionally requires:
# AUTOTRADE_ENABLED=true
# HYPERLIQUID_PRIVATE_KEY=<automation key from your secret manager>
LIVE_TRADING_ACK=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_ASSETS=["BTC","ETH","SOL"]
HYPERLIQUID_INTERVAL=5m
HYPERLIQUID_MAX_SLIPPAGE_PCT=0.01

# CUSTOMER CONNECTIONS
# Market/news/broker API keys added in the UI are stored locally in
# data/customer_runtime.sqlite3 and encrypted with data/.customer_runtime.key.
# Both files stay outside source control. Back up the key securely if you need
# those encrypted credentials to survive a machine migration.
#
# For decision-grade live-price cross-checking, configure at least two independent
# market-data connections in the UI. The second provider validates the first; it
# does not become a fallback if the first provider fails.

# DEPLOYMENT VALIDATION GATES
STRATEGY_VALIDATION_MAX_AGE_DAYS=30
MIN_BACKTEST_SHARPE=1.0
MAX_BACKTEST_DRAWDOWN_PCT=20.0
MIN_BACKTEST_WIN_RATE=0.52
MIN_BACKTEST_TRADES=30
MIN_BACKTEST_PROFIT_FACTOR=1.20

# PAPER EXECUTION ASSUMPTIONS
PAPER_STARTING_BALANCE=100000
PAPER_SLIPPAGE_BPS=5
PAPER_FEE_BPS=4

# SCHEDULER
NEWS_FETCH_INTERVAL_MIN=10
PRICE_FETCH_INTERVAL_MIN=5
RAG_REINDEX_INTERVAL_MIN=15

# Mission Control Automation
GITHUB_PAT=
GITHUB_REPO=logeshv586-code/AITradra
